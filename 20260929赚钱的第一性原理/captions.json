{
  "s01l01": [
    {
      "start": 0.14,
      "end": 1.18,
      "text": "这个项目我们不做了。"
    }
  ],
  "s02l01": [
    {
      "start": 0.155,
      "end": 1.615,
      "text": "我甚至盼着他挑个错。"
    },
    {
      "start": 2.495,
      "end": 5.535,
      "text": "三个月，预算都算到了小数点后两位。"
    }
  ],
  "s02l02": [
    {
      "start": 0.097,
      "end": 2.237,
      "text": "嫌贵，备了第二套报价。"
    },
    {
      "start": 2.437,
      "end": 6.657,
      "text": "嫌慢，排了另一份工期。可他连第一页都没看。"
    }
  ],
  "s03l01": [
    {
      "start": 0.167,
      "end": 4.267,
      "text": "我演练过他会怎么挑，唯独没问过，他还想不想做。"
    }
  ],
  "s04l01": [
    {
      "start": 0.117,
      "end": 4.837,
      "text": "解决问题的第一性原理是识别真需求，不是自我感动。"
    }
  ],
  "s05l01": [
    {
      "start": 0.161,
      "end": 2.561,
      "text": "下一次接活，他先合上电脑。"
    }
  ],
  "s05l02": [
    {
      "start": 0.21,
      "end": 2.61,
      "text": "上次结账，哪一步把你卡住了？"
    }
  ],
  "s05l03": [
    {
      "start": 0.159,
      "end": 2.279,
      "text": "两张表总差一笔。"
    },
    {
      "start": 3.179,
      "end": 7.139,
      "text": "上个月找出来的时候，我女儿都睡了。"
    }
  ],
  "s06l01": [
    {
      "start": 0.208,
      "end": 4.528,
      "text": "这回，他先用旧账试出一张能标出重复记录的表。"
    },
    {
      "start": 4.788,
      "end": 6.788,
      "text": "月底，客户发来一句话。"
    }
  ],
  "s06l02": [
    {
      "start": 0.19,
      "end": 4.03,
      "text": "我下班了。今晚，赶得上陪女儿吃饭。"
    }
  ]
}
