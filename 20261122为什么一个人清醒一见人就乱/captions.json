{
  "s01l01": [
    {
      "start": 0.08,
      "end": 2.3,
      "text": "怎么我一开口，桌上就静了？"
    }
  ],
  "s02l01": [
    {
      "start": 0.166,
      "end": 2.526,
      "text": "昨晚一个人在家，你还想得挺明白。"
    },
    {
      "start": 3.326,
      "end": 6.166,
      "text": "吃顿饭而已，聊得来就多说两句。"
    }
  ],
  "s02l02": [
    {
      "start": 0.109,
      "end": 3.589,
      "text": "今天你刚讲到一半，有人低头夹菜，有人转过脸。"
    },
    {
      "start": 4.429,
      "end": 5.509,
      "text": "你连后半句都忘了。"
    }
  ],
  "s02l03": [
    {
      "start": 0.119,
      "end": 3.119,
      "text": "是不是我说错什么了？他们是不是看不起我？"
    }
  ],
  "s03l01": [
    {
      "start": 0.184,
      "end": 2.904,
      "text": "桌上只发生了一件事：没人接话。"
    },
    {
      "start": 3.625,
      "end": 6.445,
      "text": "可你已经在心里，把刚才那句话审了三遍。"
    }
  ],
  "s03l02": [
    {
      "start": 0.164,
      "end": 4.784,
      "text": "要不赶紧说句“我这人嘴笨”，先替大家把台阶找好？"
    }
  ],
  "s04l01": [
    {
      "start": 0.096,
      "end": 3.956,
      "text": "手指碰到茶杯，你先让那句道歉在嘴边放了放。"
    }
  ],
  "s04l02": [
    {
      "start": 0.145,
      "end": 3.505,
      "text": "我有点难堪。我是怕刚才那个故事没人想听。"
    }
  ],
  "s04l03": [
    {
      "start": 0.114,
      "end": 2.194,
      "text": "情绪来了，但我还有选择。"
    }
  ],
  "s05l01": [
    {
      "start": 0.2,
      "end": 5.1,
      "text": "等了三秒，心还跳得很快。你抬起头，把后半句接上。"
    }
  ],
  "s05l02": [
    {
      "start": 0.154,
      "end": 3.074,
      "text": "我刚才是想说，那趟车我追上了。"
    },
    {
      "start": 3.394,
      "end": 5.574,
      "text": "我妈给我留的饭，到家还热着呢。"
    }
  ],
  "s06l01": [
    {
      "start": 0.114,
      "end": 3.714,
      "text": "下次一桌人忽然安静，愿你也有这三秒。"
    },
    {
      "start": 4.494,
      "end": 8.754,
      "text": "喝口茶，吃口热菜，再决定自己想说什么。"
    }
  ]
}
