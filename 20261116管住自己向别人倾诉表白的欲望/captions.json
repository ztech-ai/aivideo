{
  "s01l01": [
    {
      "start": 0.08,
      "end": 2.12,
      "text": "我差点在群里说出她的名字。"
    }
  ],
  "s02l01": [
    {
      "start": 0.123,
      "end": 3.703,
      "text": "晚上十一点，小禾刚交的第三版方案又被退了。"
    },
    {
      "start": 4.422,
      "end": 7.043,
      "text": "她点开几个同事的小群，按住语音。"
    }
  ],
  "s02l02": [
    {
      "start": 0.136,
      "end": 3.856,
      "text": "我加班改了三天，会上怎么一句都没让我讲完？"
    },
    {
      "start": 4.376,
      "end": 6.996,
      "text": "散会后，小许还悄悄跟我说……"
    }
  ],
  "s03l01": [
    {
      "start": 0.136,
      "end": 2.776,
      "text": "说到那个名字，她才听清自己这条语音。"
    },
    {
      "start": 3.536,
      "end": 7.616,
      "text": "前半段是她的委屈，后半段，是人家只说给她听的话。"
    }
  ],
  "s03l02": [
    {
      "start": 0.156,
      "end": 4.176,
      "text": "我就是想找个人听一会儿。干吗把她也讲进去呢？"
    }
  ],
  "s04l01": [
    {
      "start": 0.221,
      "end": 5.141,
      "text": "“把真诚，真心，真话，留给那些真正爱我们的人。”"
    }
  ],
  "s05l01": [
    {
      "start": 0.114,
      "end": 2.974,
      "text": "姐，方案又被退了，我心里堵得慌。"
    },
    {
      "start": 3.314,
      "end": 4.714,
      "text": "你有空听我说两句吗？"
    }
  ],
  "s05l02": [
    {
      "start": 0.248,
      "end": 3.908,
      "text": "有啊，我正收衣服呢。你慢慢说，姐听着。"
    }
  ],
  "s06l01": [
    {
      "start": 0.155,
      "end": 2.435,
      "text": "电话那头，衣架轻轻碰了一下。"
    },
    {
      "start": 3.175,
      "end": 5.015,
      "text": "小禾终于把会上的委屈讲完了。"
    },
    {
      "start": 5.895,
      "end": 9.095,
      "text": "小许的那句话，也好好地留在了她们两个人之间。"
    }
  ]
}
