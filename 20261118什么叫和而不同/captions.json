{
  "s01l01": [
    {
      "start": 0.08,
      "end": 3.06,
      "text": "爸，看海还比不上一盆花？"
    }
  ],
  "s02l01": [
    {
      "start": 0.2,
      "end": 3.6,
      "text": "女儿头一回看海，站在岸边舍不得走。"
    },
    {
      "start": 3.96,
      "end": 7.48,
      "text": "十年了，她还记得浪花扑到鞋面上的凉意。"
    }
  ],
  "s02l02": [
    {
      "start": 0.149,
      "end": 3.109,
      "text": "这回她挑了间推窗就能看见海的房，"
    },
    {
      "start": 3.349,
      "end": 4.929,
      "text": "想让爸也高兴一次。"
    }
  ],
  "s03l01": [
    {
      "start": 0.169,
      "end": 1.589,
      "text": "你瞧，花尖儿松了。"
    },
    {
      "start": 2.549,
      "end": 6.429,
      "text": "我等了它三年，今晚怕是一倒茶的工夫，就错过去了。"
    }
  ],
  "s03l02": [
    {
      "start": 0.201,
      "end": 2.781,
      "text": "她顺着爸的手看过去，才发现，"
    },
    {
      "start": 2.981,
      "end": 5.441,
      "text": "小板凳和茶杯早就摆好了。"
    }
  ],
  "s04l01": [
    {
      "start": 0.232,
      "end": 4.172,
      "text": "她盼着推窗那一刻，爸也盼着花开的那一刻。"
    }
  ],
  "s04l02": [
    {
      "start": 0.129,
      "end": 2.709,
      "text": "地图不一样，不代表谁走错了路。"
    }
  ],
  "s05l01": [
    {
      "start": 0.144,
      "end": 4.124,
      "text": "爸，开花的时候，给我拍一张呗。我还真没见过。"
    }
  ],
  "s05l02": [
    {
      "start": 0.182,
      "end": 4.522,
      "text": "行。你也给我录一段，海浪拍在岸上，到底有多响？"
    }
  ],
  "s06l01": [
    {
      "start": 0.197,
      "end": 2.857,
      "text": "第二天，女儿在海边点开照片。"
    },
    {
      "start": 3.137,
      "end": 7.337,
      "text": "爸拍得有点糊，那朵白花倒是开满了整个屏幕。"
    }
  ],
  "s06l02": [
    {
      "start": 0.147,
      "end": 2.987,
      "text": "小院里，爸也收到了十秒钟的海。"
    },
    {
      "start": 3.167,
      "end": 5.667,
      "text": "他听完了，又从头听了一遍。"
    }
  ]
}
